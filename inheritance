
#include <iostream>
#include <string>
using namespace std;

// Base class
class Person {
protected:
    string name;

public:
    void setName(string n) {
        name = n;
    }

    void displayName() {
        cout << "Name: " << name << endl;
    }
};

// Derived class 1
class Student : public Person {
protected:
    string studentID;

public:
    void setStudentID(string id) {
        studentID = id;
    }

    void displayStudentID() {
        cout << "Student ID: " << studentID << endl;
    }
};

// Derived class 2
class UniversityStudent : public Student {
private:
    string university;

public:
    void setUniversity(string u) {
        university = u;
    }

    void displayUniversity() {
        cout << "University: " << university << endl;
    }
};

int main() {
    UniversityStudent s;

    // Inherited from Person
    s.setName("John");
    s.displayName();

    // Defined in Student
    s.setStudentID("ST101");
    s.displayStudentID();

    // Defined in UniversityStudent
    s.setUniversity("Makerere University");
    s.displayUniversity();

    return 0;
}
